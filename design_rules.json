  "shot_plan_base": [
    {
      "no": 1,
      "name": "白底主图",
      "spec": "1:1，主体占画面 65%~75%，纯白或浅灰背景，无杂物",
      "purpose": "决定点击率，只放一个主卖点 + 价格锚点",
      "tip": "手机横放拍、开闪光灯易反光，用两张 A4 纸做反光板"
    },
    {
      "no": 2,
      "name": "正面全景",
      "spec": "自然光，45° 或正上方俯拍，完整入镜不留切边",
      "purpose": "让人一眼看清是什么、大概什么成色",
      "tip": "靠窗拍，别用顶灯直射，阴影会吃掉细节"
    },
    {
      "no": 3,
      "name": "关键细节特写",
      "spec": "近距离对焦，突出材质 / 接口 / 按键 / logo",
      "purpose": "证明是真机实拍，降低「网图」疑虑",
      "tip": "用手指做参照物，顺便体现尺寸"
    },
    {
      "no": 4,
      "name": "瑕疵 / 使用痕迹特写",
      "spec": "把最明显的瑕疵拍清楚，不要回避",
      "purpose": "主动披露可大幅降低到手刀和退货率",
      "tip": "文案同步写「正常使用痕迹，介者慎拍」"
    },
    {
      "no": 5,
      "name": "配件全家福 + 尺寸参照",
      "spec": "所有随附配件平铺，旁边放尺子或常见物（如银行卡）",
      "purpose": "减少「少发了配件」类纠纷",
      "tip": "缺什么就写清楚缺什么，别用「如图」含糊"
    }
  ],
